NUXT_PUBLIC_API_BASE=https://localhost:7129/api

# Required in production for calls across mobile networks and restrictive NATs.
# Use a TLS-enabled coturn/managed TURN endpoint and keep the credential secret
# in the deployment environment rather than committing a real one here.
NUXT_PUBLIC_TURN_URL=turns://turn.your-domain.example:5349?transport=tcp
NUXT_PUBLIC_TURN_USERNAME=replace-with-turn-username
NUXT_PUBLIC_TURN_CREDENTIAL=replace-with-turn-password
